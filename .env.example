# OpenClaw Voice - Environment Variables
# Copy this file to .env and edit with your values

# ===========================================
# OpenClaw Image Configuration
# ===========================================

# Use official image (already pulled)
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# ===========================================
# OpenClaw Gateway Configuration
# ===========================================

# Gateway bind mode: lan (default) or loopback
OPENCLAW_GATEWAY_BIND=lan

# Gateway port (host:container) - Custom port
OPENCLAW_GATEWAY_PORT=26523

# Gateway token (for Voice authentication)
OPENCLAW_GATEWAY_TOKEN=openclaw-your-gateway-token-here

# Timezone
OPENCLAW_TZ=Asia/Shanghai

# ===========================================
# Bailian API Configuration (STT + TTS)
# ===========================================

# Bailian API Key (from https://bailian.console.aliyun.com/)
# IMPORTANT: This key must have STT and TTS permissions
ALI_BAILIAN_API_KEY=sk-your-api-key-here

# ===========================================
# OpenClaw Voice Configuration
# ===========================================

# Voice service port
OPENCLAW_VOICE_PORT=8765

# STT Model
OPENCLAW_STT_MODEL=qwen3-asr-flash
OPENCLAW_STT_LANGUAGE=zh

# TTS Model
OPENCLAW_TTS_MODEL=qwen3-tts-flash

# TTS Voice: Cherry, Bella, Sarah, Jack, Allie
OPENCLAW_TTS_VOICE=Cherry
OPENCLAW_TTS_LANGUAGE=Chinese

# Streaming Configuration
OPENCLAW_TTS_STREAMING=true
OPENCLAW_SUBTITLE_STREAMING=true

# TTS Buffer Configuration
# 时间缓冲（秒）：收到音频后等待 X 秒再播放
# 推荐值：0.1-1.0 秒
#   - 0.1: 低延迟，适合网络好的环境
#   - 0.5: 平衡模式，推荐默认值 ✅
#   - 1.0: 高流畅，适合网络差的环境
OPENCLAW_TTS_TIME_BUFFER_SECONDS=0.5

# 数据缓冲（字节）：累积 X 字节再发送，减少发送频率
# 推荐值：1024-8192 字节
#   - 1024: 低延迟
#   - 8192: 平衡模式，推荐默认值 ✅
#   - 16384: 高流畅
OPENCLAW_TTS_DATA_BUFFER_SIZE=8192
