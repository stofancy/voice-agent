# OpenClaw Voice Agent - Environment Variables
# Copy this file to .env and edit with your values
#
# This is for standalone voice-agent service.
# For docker compose with gateway, use .env.example.gateway

# ===========================================
# LLM Configuration
# ===========================================
# Provider: openclaw_gateway | bailian | openai | gemini
OPENCLAW_LLM_PROVIDER=bailian
OPENCLAW_LLM_API_KEY=your-api-key-here
# OPENCLAW_LLM_MODEL=qwen3.5-flash
# OPENCLAW_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===========================================
# STT Configuration
# ===========================================
# Provider: bailian | openai_compatible | gemini
OPENCLAW_STT_PROVIDER=bailian
OPENCLAW_STT_API_KEY=your-api-key-here
# OPENCLAW_STT_MODEL=qwen3-asr-flash
# OPENCLAW_STT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENCLAW_STT_LANGUAGE=zh

# ===========================================
# TTS Configuration
# ===========================================
# Provider: bailian | bailian_realtime | openai_compatible | gemini
OPENCLAW_TTS_PROVIDER=bailian
OPENCLAW_TTS_API_KEY=your-api-key-here
# OPENCLAW_TTS_MODEL=qwen3-tts-flash
# OPENCLAW_TTS_VOICE=Cherry
# OPENCLAW_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
OPENCLAW_TTS_LANGUAGE=Chinese

# TTS Voice Instructions (only for instruct TTS model)
# Natural language description to control voice style, e.g.:
# OPENCLAW_TTS_INSTRUCTIONS=年轻女性，音调偏高，语气温柔治愈又不失活力。

# ===========================================
# Audio & Streaming Configuration
# ===========================================

# TTS sample rate (default: 24000)
OPENCLAW_TTS_SAMPLE_RATE=24000

# Streaming Configuration
OPENCLAW_TTS_STREAMING=true
OPENCLAW_SUBTITLE_STREAMING=true

# TTS Buffer Configuration
# 时间缓冲（秒）：收到音频后等待 X 秒再播放 (推荐: 0.1-1.0)
OPENCLAW_TTS_TIME_BUFFER_SECONDS=0.5

# 数据缓冲（字节）：累积 X 字节再发送 (推荐: 1024-8192)
OPENCLAW_TTS_DATA_BUFFER_SIZE=8192

# ===========================================
# LLM Backend Configuration
# ===========================================

# Backend request timeout in seconds (default: 30)
OPENCLAW_BACKEND_TIMEOUT_S=30

# Enable HTTP/2 for backend connections (default: true)
OPENCLAW_BACKEND_HTTP2=true

# ===========================================
# Server Configuration
# ===========================================

# Voice service port
OPENCLAW_PORT=8765
OPENCLAW_REQUIRE_AUTH=false
# OPENCLAW_MASTER_KEY=your-master-key  # Only needed if REQUIRE_AUTH=true

# ===========================================
# Performance Logging
# ===========================================
# Set to true to enable detailed performance logging to logs/performance.jsonl
OPENCLAW_PERF_LOGGING=false
