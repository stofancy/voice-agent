# Development Environment Configuration
# For local development with hot-reload

# Bailian API (STT + TTS)
ALI_BAILIAN_API_KEY=sk-your-api-key-here

# OpenClaw Gateway Configuration
# Connect to Docker Gateway (remote mode)
OPENCLAW_GATEWAY_BIND=remote
OPENCLAW_GATEWAY_URL=http://localhost:26523
OPENCLAW_GATEWAY_PORT=26523
OPENCLAW_GATEWAY_TOKEN=openclaw-your-gateway-token-here

# Voice Service Configuration
OPENCLAW_VOICE_PORT=8766
OPENCLAW_STT_MODEL=qwen3-asr-flash
OPENCLAW_TTS_MODEL=qwen3-tts-flash
OPENCLAW_TTS_VOICE=Cherry

# Development Mode
OPENCLAW_DEV_MODE=true
