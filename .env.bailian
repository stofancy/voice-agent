# OpenClaw Voice - Bailian Edition Configuration
# Copy to .env and customize

# ===================
# Required: Bailian API Key
# ===================
ALI_BAILIAN_API_KEY=REDACTED-gateway-provider-key

# ===================
# Optional: OpenClaw Gateway Connection
# ===================
# Connect to your OpenClaw instance for full agent features
# Comment out to use standalone mode

# ===================
# STT Configuration (Bailian)
# ===================
OPENCLAW_STT_MODEL=qwen3-asr-flash
OPENCLAW_STT_LANGUAGE=zh

# Available models:
# - qwen3-asr-flash: Fast, accurate, up to 5 minutes
# - qwen3-asr-flash-filetrans: Long audio (up to 12 hours, async)

# Supported languages: zh, yue, en, ja, de, ko, ru, fr, pt, ar, it, es, hi, id, th, tr, uk, vi, cs, da, fil, fi, is, ms, no, pl, sv

# ===================
# TTS Configuration (Bailian)
# ===================
OPENCLAW_TTS_MODEL=qwen3-tts-flash
OPENCLAW_TTS_VOICE=Cherry
OPENCLAW_TTS_LANGUAGE=Chinese

# Available models:
# - qwen3-tts-flash: Fast, cost-effective
# - qwen3-tts-instruct-flash: With instruction control (tone, speed, emotion)

# Available voices:
# - Cherry: Sweet female (default)
# - Bella: Gentle female
# - Sarah: Mature female
# - Jack: Calm male
# - Allie: Lively female

# ===================
# Server Configuration
# ===================
OPENCLAW_PORT=8765
OPENCLAW_REQUIRE_AUTH=false
# OPENCLAW_MASTER_KEY=your-master-key  # Only needed if REQUIRE_AUTH=true

# ===================
# Audio Configuration
# ===================
# Input: 16kHz PCM (from browser)
# Output: 24kHz PCM (to browser)
