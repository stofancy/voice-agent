# ===========================================
# LLM Configuration
# ===========================================
# Provider: openclaw_gateway | bailian | openai | gemini
OPENCLAW_LLM_PROVIDER=bailian
OPENCLAW_LLM_API_KEY=your-api-key-here

# ===========================================
# STT Configuration
# ===========================================
OPENCLAW_STT_PROVIDER=bailian
OPENCLAW_STT_API_KEY=your-api-key-here
# OPENCLAW_STT_MODEL=qwen3-asr-flash
OPENCLAW_STT_LANGUAGE=zh

# ===========================================
# TTS Configuration
# ===========================================
OPENCLAW_TTS_PROVIDER=bailian
OPENCLAW_TTS_API_KEY=your-api-key-here
# OPENCLAW_TTS_MODEL=qwen3-tts-flash
# OPENCLAW_TTS_VOICE=Cherry
OPENCLAW_TTS_LANGUAGE=Chinese

# TTS Voice Instructions (only for instruct TTS model)
# OPENCLAW_TTS_INSTRUCTIONS=年轻女性，音调偏高，语气温柔治愈又不失活力。

# ===========================================
# Server Configuration
# ===========================================
OPENCLAW_PORT=8765
OPENCLAW_REQUIRE_AUTH=false
# OPENCLAW_MASTER_KEY=your-master-key

# ===========================================
# Audio & Streaming Configuration
# ===========================================
OPENCLAW_TTS_STREAMING=true
OPENCLAW_SUBTITLE_STREAMING=true
OPENCLAW_TTS_TIME_BUFFER_SECONDS=0.5
OPENCLAW_TTS_DATA_BUFFER_SIZE=8192
