# OpenClaw Voice Agent + Gateway - Environment Variables
# Copy this file to .env for docker compose deployments
#
# This includes gateway-related variables for docker compose setups.
# For standalone voice-agent only, use .env.example

# ===========================================
# OpenClaw Gateway Configuration
# ===========================================

# Gateway bind mode: lan (default) or loopback
OPENCLAW_GATEWAY_BIND=lan

# Gateway port (host:container)
OPENCLAW_GATEWAY_PORT=18789

# Bridge port
OPENCLAW_BRIDGE_PORT=18790

# Gateway token (for Voice authentication)
OPENCLAW_GATEWAY_TOKEN=your-gateway-token

# Default model for Gateway
OPENCLAW_DEFAULT_MODEL=bailian/qwen3-coder-next

# Timezone
OPENCLAW_TZ=Asia/Shanghai

# ===========================================
# LLM Configuration (via Gateway)
# ===========================================
OPENCLAW_LLM_PROVIDER=openclaw_gateway
OPENCLAW_LLM_API_KEY=your-gateway-token-here
OPENCLAW_LLM_MODEL=agent:voice
OPENCLAW_LLM_BASE_URL=http://openclaw-gateway:18789/v1

# ===========================================
# STT Configuration
# ===========================================
OPENCLAW_STT_PROVIDER=bailian
OPENCLAW_STT_API_KEY=your-bailian-api-key
OPENCLAW_STT_MODEL=qwen3-asr-flash
OPENCLAW_STT_LANGUAGE=zh

# ===========================================
# TTS Configuration
# ===========================================
OPENCLAW_TTS_PROVIDER=bailian_realtime
OPENCLAW_TTS_API_KEY=your-bailian-api-key
OPENCLAW_TTS_MODEL=qwen3-tts-flash-realtime
OPENCLAW_TTS_VOICE=Maia
OPENCLAW_TTS_LANGUAGE=Chinese
# OPENCLAW_TTS_INSTRUCTIONS=年轻女性，音调偏高，语气温柔治愈又不失活力。

# ===========================================
# Audio & Streaming Configuration
# ===========================================
OPENCLAW_TTS_STREAMING=true
OPENCLAW_SUBTITLE_STREAMING=true
OPENCLAW_TTS_TIME_BUFFER_SECONDS=0.5
OPENCLAW_TTS_DATA_BUFFER_SIZE=8192
OPENCLAW_TTS_SAMPLE_RATE=24000

# ===========================================
# Backend Configuration
# ===========================================
OPENCLAW_BACKEND_TIMEOUT_S=30
OPENCLAW_BACKEND_HTTP2=false

# ===========================================
# Server Configuration
# ===========================================
OPENCLAW_PORT=8765
OPENCLAW_REQUIRE_AUTH=false

# ===========================================
# Docker Network
# ===========================================
# External network name (created by official OpenClaw)
OPENCLAW_NETWORK_NAME=openclaw_default

# ===========================================
# Performance Logging
# ===========================================
OPENCLAW_PERF_LOGGING=false
