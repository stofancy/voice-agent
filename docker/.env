# Voice Agent Plugin - Environment Configuration

# 阿里百炼 API Key (必填)
ALI_BAILIAN_API_KEY=sk-your-api-key-here

# WebUI 端口 (可选，默认 5182)
WEBUI_PORT=5182

# WebSocket 端口 (可选，默认 8774)
WS_PORT=8774

# 代理配置
HTTP_PROXY=http://192.168.0.147:7890
HTTPS_PROXY=http://192.168.0.147:7890
NO_PROXY=localhost,127.0.0.1,.local
