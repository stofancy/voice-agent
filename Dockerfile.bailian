# OpenClaw Voice - Bailian Edition Docker image
# Minimal Python-only build (no system dependencies)

FROM python:3.11-slim

# Create app directory
WORKDIR /app

# Copy requirements
COPY requirements.txt ./

# Install Python dependencies only (use Aliyun mirror for reliability)
RUN pip install --no-cache-dir -r requirements.txt -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com

# Copy application code
COPY src/ ./src/

# Create directories
RUN mkdir -p /app/data /app/logs

# Environment variables
ENV OPENCLAW_HOST=0.0.0.0
ENV OPENCLAW_PORT=8765
ENV OPENCLAW_STT_MODEL=qwen3-asr-flash
ENV OPENCLAW_TTS_MODEL=qwen3-tts-flash
ENV OPENCLAW_TTS_VOICE=Cherry
ENV OPENCLAW_REQUIRE_AUTH=false

# Expose port
EXPOSE 8765

# Health check (simple Python HTTP check)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8765/')" || exit 1

# Run server
CMD ["python", "-m", "uvicorn", "src.server.main:app", "--host", "0.0.0.0", "--port", "8765"]
