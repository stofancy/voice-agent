# OpenClaw Voice - Environment Variables
# Copy to .env and customize

# ===========================================
# OpenClaw Image Configuration
# ===========================================

# Use official image (recommended)
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest

# Or build locally
# OPENCLAW_IMAGE=openclaw:local

# ===========================================
# OpenClaw Gateway Configuration
# ===========================================

# Gateway bind mode: lan (default) or loopback
# Use 'lan' for host access, 'loopback' for container-only
OPENCLAW_GATEWAY_BIND=lan

# Gateway port (host:container)
OPENCLAW_GATEWAY_PORT=18789

# Bridge port (for multi-gateway setups)
OPENCLAW_BRIDGE_PORT=18790

# Gateway token (for CLI and Voice authentication)
OPENCLAW_GATEWAY_TOKEN=REDACTED-openclaw-voice-token

# Config and workspace directories
OPENCLAW_CONFIG_DIR=/home/ztmdsbt/.openclaw
OPENCLAW_WORKSPACE_DIR=/home/ztmdsbt/.openclaw/workspace

# Timezone
OPENCLAW_TZ=Asia/Shanghai

# ===========================================
# Bailian API Configuration (STT + TTS)
# ===========================================

# Bailian API Key (from https://bailian.console.aliyun.com/)
ALI_BAILIAN_API_KEY=REDACTED-gateway-provider-key

# ===========================================
# OpenClaw Voice Configuration
# ===========================================

# Voice service port
OPENCLAW_VOICE_PORT=8765

# STT Model: qwen3-asr-flash (fast, up to 5 min audio)
OPENCLAW_STT_MODEL=qwen3-asr-flash
OPENCLAW_STT_LANGUAGE=zh

# TTS Model: qwen3-tts-flash (fast) or qwen3-tts-instruct-flash (with instructions)
OPENCLAW_TTS_MODEL=qwen3-tts-flash

# TTS Voice: Cherry, Bella, Sarah, Jack, Allie
OPENCLAW_TTS_VOICE=Cherry
OPENCLAW_TTS_LANGUAGE=Chinese

# ===========================================
# Optional: Claude Session (if using Codex)
# ===========================================

# CLAUDE_AI_SESSION_KEY=
# CLAUDE_WEB_SESSION_KEY=
# CLAUDE_WEB_COOKIE=
