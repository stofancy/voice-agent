# Local Development Environment
# Backend only - loaded automatically by uvicorn

# Bailian API Key (required for STT/TTS/LLM)
OPENCLAW_BAILIAN_API_KEY=sk-your-api-key-here
ALI_BAILIAN_API_KEY=sk-your-api-key-here

# Backend Configuration
OPENCLAW_HOST=0.0.0.0
OPENCLAW_PORT=8766
OPENCLAW_STT_MODEL=qwen3-asr-flash
OPENCLAW_STT_LANGUAGE=zh
OPENCLAW_TTS_MODEL=qwen3-tts-flash
OPENCLAW_TTS_VOICE=Cherry
OPENCLAW_TTS_LANGUAGE=Chinese
OPENCLAW_LLM_MODEL=qwen-plus
